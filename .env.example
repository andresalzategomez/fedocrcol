# ==========================================================
# FedOCR Colombia — variables de entorno (ejemplo)
# Copia a .env y completa. NUNCA subas .env al repositorio.
# ==========================================================

# --- Cliente (expuestas al navegador, protegidas por RLS) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Servidor (NUNCA en el cliente) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=            # usado por la API /api/v1 (cliente por-usuario con RLS)
SUPABASE_SERVICE_ROLE_KEY=

# --- Pagos ---
# Secreto HMAC de la pasarela (Bold / PayU) para validar el webhook.
PAYMENT_WEBHOOK_SECRET=
