# ==========================================================
# FedOCR Colombia — variables de entorno (ejemplo)
# Copia a .env y completa. NUNCA subas .env al repositorio.
# ==========================================================

# --- Cliente (expuestas al navegador, protegidas por RLS) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Servidor (NUNCA en el cliente) ---
# OJO: el prefijo SUPABASE_ está reservado por Lovable; se usa EXT_SUPABASE_
EXT_SUPABASE_URL=
EXT_SUPABASE_ANON_KEY=            # usado por la API /api/v1 (cliente por-usuario con RLS)
EXT_SUPABASE_SERVICE_ROLE_KEY=

# --- Pagos ---
# --- Pasarela de pagos (Bold) ---
# Panel de Bold -> Integraciones -> Llaves de integración (pruebas y producción
# tienen cada una su par). Webhook: Integraciones -> Webhooks, URL
#   https://<tu-dominio>/api/public/pagos/webhook
# La llave de identidad es pública; la secreta firma los webhooks: nunca al repo.
BOLD_IDENTITY_KEY=
BOLD_SECRET_KEY=
# "true" SOLO con llaves de pruebas (Bold firma los webhooks con llave vacía
# en ese ambiente, lo que los hace falsificables). En producción, no definirla.
BOLD_TEST_MODE=

# --- Correo transaccional (Resend) ---
# https://resend.com/api-keys — el conector de Resend de Lovable NO sirve
# aquí porque este proyecto no usa Lovable Cloud; hay que poner la key real
# como variable de entorno del servidor.
RESEND_API_KEY=
# Remitente verificado en Resend, ej: "FedOCR Colombia <notificaciones@fedocrcol.com>"
RESEND_FROM_EMAIL=
